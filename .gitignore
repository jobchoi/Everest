# [수정] /.gitignore (H-141)
# Python/Django/Security/OS에 최적화된 .gitignore
# -----------------------------------------------------------------
# 1. 보안 (Security) - (H-140 '암호' 요청)
#    (비밀 키, API 키, 로컬 설정)
# -----------------------------------------------------------------
.env
local_settings.py
*.key
*.pem


# -----------------------------------------------------------------
# 2. Python 가상 환경 (Virtual Environments) - (H-138 '시행착오' 해결)
#    (H-118에서 '누락'되었던 '핵심')
# -----------------------------------------------------------------
venv/
*.venv/
env/
.env/


# -----------------------------------------------------------------
# 3. Python 캐시 (Bytecode) - (H-115)
# -----------------------------------------------------------------
venv/
# 1. (추가) Python Bytecode Cache ('.pyc' 파일이 담기는 폴더)
__pycache__/
# 2. (추가) Python Bytecode Files ('.pyc' 파일 자체)
*.pyc
*.pyo
*.pyd


# -----------------------------------------------------------------
# 4. Django 프로젝트 (Project Specific)
# -----------------------------------------------------------------
# (우리는 PostgreSQL을 쓰지만, '다른 환경'의 실수를 막기 위함)
db.sqlite3
db.sqlite3-journal

# (Phase 2에서 추가될 '사용자 업로드' 미디어)
media/

# ('collectstatic' 명령어로 '배포'시 생성되는 정적 파일)
staticfiles/


# -----------------------------------------------------------------
# 5. IDE / 편집기 (Editor Config) - (H-140 'VSCode' 수정)
# -----------------------------------------------------------------
# (H-140의 '위험한' 예외 규칙을 '제거'하고 '전체' 무시)
.vscode/
.history/

# (다른 환경: PyCharm)
.idea/


# -----------------------------------------------------------------
# 6. 운영 체제 (OS Specific)
# -----------------------------------------------------------------
# (macOS)
.DS_Store

# (Windows)
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/


# -----------------------------------------------------------------
# 7. 로그 및 테스트 (Logs & Testing)
# -----------------------------------------------------------------
*.log
npm-debug.log
.coverage
htmlcov/